# ---------------------------------------------------------------------------
# Everything here is OPTIONAL. With no .env at all, the app runs end to end:
# leads save to a local JSON file, emails are logged instead of sent, and the
# listing-kit generator falls back to its built-in templates.
# ---------------------------------------------------------------------------

# --- Admin dashboard (/admin) ---------------------------------------------
# Without ADMIN_PASSWORD the demo password "kw-demo-2026" is active.
ADMIN_PASSWORD=
# Signs the admin session cookie. Use a long random string in production.
ADMIN_SESSION_SECRET=

# --- Lead storage ----------------------------------------------------------
# Set both to store leads in Supabase instead of .data/leads.json.
# Table DDL is in supabase/schema.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Transactional email (pick one) ----------------------------------------
RESEND_API_KEY=
SENDGRID_API_KEY=
# Verified sender, e.g. "Maple & Grand <hello@yourdomain.ca>"
NOTIFY_FROM_EMAIL=
# Where new-lead alerts go. Defaults to siteConfig.email.
NOTIFY_TO_EMAIL=

# --- CRM sync --------------------------------------------------------------
# Follow Up Boss / Zapier / Make webhook. Receives a JSON payload per lead.
CRM_WEBHOOK_URL=

# --- AI listing copy -------------------------------------------------------
# With no key, the listing-kit generator uses deterministic templates.
ANTHROPIC_API_KEY=

# --- Booking ---------------------------------------------------------------
# Calendly / Cal.com embed URL. If set, the tour modal embeds it instead of
# rendering the built-in booking form.
NEXT_PUBLIC_BOOKING_URL=
